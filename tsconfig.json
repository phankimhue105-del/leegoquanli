{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "types": ["vite/client"],
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowJs": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "exclude": ["dist", "src_backup_milestone5d", "src_backup_timetable_sync", "src_backup_ta_access", "src_backup_staff_linking", "src_backup_three_fixes", "verify_timetable_sync.ts", "verify_ta_access.ts", "verify_staff_linking.ts", "verify_three_fixes.ts"]
}
